{
  "name": "eslint-plugin-supabase-services-layer",
  "version": "2.1.0",
  "description": "ESLint plugin to enforce services layer architecture pattern in Supabase projects by restricting direct Supabase client imports to configured service directories",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "supabase",
    "services-layer",
    "architecture",
    "layered-architecture",
    "code-organization",
    "database",
    "react",
    "nextjs"
  ],
  "homepage": "https://github.com/straiforos/eslint-supabase-client-package#readme",
  "bugs": {
    "url": "https://github.com/straiforos/eslint-supabase-client-package/issues"
  },
  "repository": {
    "type": "module",
    "url": "git+https://github.com/straiforos/eslint-supabase-client-package.git",
    "directory": "packages/eslint-plugin-supabase-services-layer"
  },
  "license": "MIT",
  "author": "Stephentraiforos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build && pnpm test",
    "prepare": "husky"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "minimatch": "^10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/minimatch": "^5.1.2",
    "@typescript-eslint/parser": "^8.55.0",
    "@typescript-eslint/rule-tester": "^8.55.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3",
    "typescript": "^5",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
